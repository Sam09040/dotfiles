# Theme catppuccin-mocha-lavender

theme = "catppuccin-mocha.conf"

# Font config

font-family = "FiraCode Nerd Font"
font-size = 14

# reload config

keybind = ctrl+shift+r=reload_config

# splitting bindings

keybind = ctrl+shift+h=new_split:left
keybind = ctrl+shift+j=new_split:up
keybind = ctrl+shift+k=new_split:down
keybind = ctrl+shift+l=new_split:right

# moving bindings

keybind = ctrl+alt+h=goto_split:left
keybind = ctrl+alt+j=goto_split:up
keybind = ctrl+alt+k=goto_split:down
keybind = ctrl+alt+l=goto_split:right

# Command pallete

keybind = ctrl+shift+p=toggle_command_palette

# window options

window-height = 38
window-width = 140

# Background options
# background-opacity = 0.2

# shaders

custom-shader = shaders/cursor_smear.glsl
custom-shader = shaders/sparks.glsl

# window-decoration

window-decoration = client

# cursor color

cursor-color = #d20efc

# others

split-divider-color = #3584e4

# Desativa recursos de detecção de teclas que conflitam com o método de entrada do sistema

window-inherit-working-directory = true
