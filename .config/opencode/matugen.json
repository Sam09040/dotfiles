{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "primary": "#6269ea",
    "on_primary": "#070712",
    "secondary": "#954be7",
    "on_secondary": "#f8f9ff",
    "surface": "#070a36",
    "on_surface": "#f2f2f3",
    "surface_variant": "#0a0d48",
    "on_surface_variant": "#afafb6",
    "background": "#070a36",
    "on_background": "#f2f2f3",
    "error": "#fd4663",
    "on_error": "#181925",
    "outline": "#5d5f6d",
    "outline_variant": "#5d5f72"
  },
  "theme": {
    "primary": {
      "dark": "primary",
      "light": "primary"
    },
    "secondary": {
      "dark": "secondary",
      "light": "secondary"
    },
    "accent": {
      "dark": "primary",
      "light": "primary"
    },
    "error": {
      "dark": "error",
      "light": "error"
    },
    "warning": {
      "dark": "secondary",
      "light": "secondary"
    },
    "success": {
      "dark": "secondary",
      "light": "secondary"
    },
    "info": {
      "dark": "primary",
      "light": "primary"
    },
    "text": {
